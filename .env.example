# FilmDeck environment. Copy to your shell profile or export these before starting the server. PLACEHOLDERS ONLY: never commit real keys.
# Nothing here is needed for Mock mode.

# --- Live mode (real Claude). Costs money. Server-side only: the browser never sees it. ---
ANTHROPIC_API_KEY=
# Optional model override (default: see tools/ai/claude.mjs)
# FILMDECK_MODEL=

# --- Optional: show a cost figure in run.json and the live evaluation report (USD per million tokens, YOUR numbers; no prices are built in) ---
# FILMDECK_PRICE_IN_PER_MTOK=
# FILMDECK_PRICE_OUT_PER_MTOK=
# FILMDECK_PRICE_CACHE_READ_PER_MTOK=
# FILMDECK_PRICE_CACHE_WRITE_PER_MTOK=

# --- Browser QA / tests: folder that contains playwright-core. `npm run setup:qa` creates .qa-env and tests find it automatically. ---
# FILMDECK_QA_MODULES=

# --- Web server (optional) ---
# FILMDECK_MAX_QUEUED=5      # jobs allowed to wait behind the running one (1..20)

# --- Test-only (fake provider). Never set these for real use. ---
# ANTHROPIC_BASE_URL=
# FILMDECK_RETRY_DELAY_MS=
# FILMDECK_REQUEST_TIMEOUT_MS=
